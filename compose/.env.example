# Copy to .env and fill in before `docker compose up`.
RSDW_OWNER_ID=
RSDW_ADMIN_PASSWORD=
# Leave empty for an open world (must be set — even to empty — so Compose passes "").
RSDW_PASSWORD=
RSDW_SERVER_NAME=dragonwilds-local
RSDW_WORLD_NAME=Homelab World
GAME_PORT=7777
BEACON_PORT=8888
RSDW_AUTO_STOP_ON_UPDATE=false
STEAMAPPVALIDATE=0
MEM_LIMIT=8g
CPU_LIMIT=2.0
# RSDW_IMAGE=ghcr.io/runescape/rsdw-dedicated
